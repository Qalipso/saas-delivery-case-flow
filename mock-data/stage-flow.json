{
  "tenant_id": "tenant_helix",
  "name": "Default 7-stage flow",
  "stages": [
    {
      "name": "Kickoff",
      "sla_days": 5,
      "required_role": "IM",
      "handoff_form_schema": {
        "type": "object",
        "required": ["primary_contact", "exec_sponsor", "target_go_live_date", "success_criteria"],
        "properties": {
          "primary_contact": { "type": "string" },
          "exec_sponsor": { "type": "string" },
          "target_go_live_date": { "type": "string", "format": "date" },
          "success_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    {
      "name": "Discovery",
      "sla_days": 10,
      "required_role": "IM",
      "handoff_form_schema": {
        "type": "object",
        "required": ["data_sources", "integration_scope", "custom_field_mapping", "user_count", "regions"],
        "properties": {
          "data_sources": { "type": "array", "items": { "type": "string" } },
          "integration_scope": { "type": "string" },
          "custom_field_mapping": { "type": "object" },
          "user_count": { "type": "integer" },
          "regions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "name": "Configuration",
      "sla_days": 14,
      "required_role": "IM",
      "handoff_form_schema": {
        "type": "object",
        "required": ["environments_configured", "sso_configured", "integrations_live", "rollback_plan"],
        "properties": {
          "environments_configured": { "type": "array", "items": { "type": "string" } },
          "sso_configured": { "type": "boolean" },
          "integrations_live": { "type": "array", "items": { "type": "string" } },
          "rollback_plan": { "type": "string" }
        }
      }
    },
    {
      "name": "UAT",
      "sla_days": 10,
      "required_role": "IM",
      "handoff_form_schema": {
        "type": "object",
        "required": ["uat_signoff_received", "outstanding_defects", "go_no_go_decision"],
        "properties": {
          "uat_signoff_received": { "type": "boolean" },
          "outstanding_defects": { "type": "array", "items": { "type": "string" } },
          "go_no_go_decision": { "type": "string", "enum": ["go", "no_go"] }
        }
      }
    },
    {
      "name": "Go-Live",
      "sla_days": 3,
      "required_role": "IM",
      "handoff_form_schema": {
        "type": "object",
        "required": ["go_live_at", "communications_sent"],
        "properties": {
          "go_live_at": { "type": "string", "format": "date-time" },
          "communications_sent": { "type": "boolean" }
        }
      }
    },
    {
      "name": "Hypercare",
      "sla_days": 14,
      "required_role": "IM",
      "handoff_form_schema": {
        "type": "object",
        "required": ["incidents_during_hypercare", "csm_assigned"],
        "properties": {
          "incidents_during_hypercare": { "type": "integer" },
          "csm_assigned": { "type": "string" }
        }
      }
    },
    {
      "name": "Handoff to CSM",
      "sla_days": 5,
      "required_role": "IM",
      "handoff_form_schema": {
        "type": "object",
        "required": ["csm_briefed", "open_risks", "early_renewal_signals"],
        "properties": {
          "csm_briefed": { "type": "boolean" },
          "open_risks": { "type": "array", "items": { "type": "string" } },
          "early_renewal_signals": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  ]
}
